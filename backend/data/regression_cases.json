{
  "_note": "점검 회귀 케이스. 형식은 tests/test_rules.py 의 기대값과 같다. dataset: sample | public | any (지금 DB의 dataset 과 맞는 케이스만 돈다). 실제 공공데이터로 바꾼 뒤에는 감수 약사가 확인한 실제 품목코드 케이스를 dataset \"public\" 으로 추가한다. expect 에 쓸 수 있는 키: rules, counts, med_count, unchecked, findings[{rule, severity, items, ingredients, group, body, body_startswith, title}]",
  "cases": [
    {
      "name": "김순자 어르신 예시 (목업)",
      "dataset": "sample",
      "age_band": "65+",
      "items": [
        {"item_seq": "S000000001", "received_from": "OO내과"},
        {"item_seq": "S000000002", "received_from": "OO내과"},
        {"item_seq": "S000000003", "received_from": "OO내과"},
        {"item_seq": "S000000005", "received_from": "OO내과"},
        {"item_seq": "S000000010", "received_from": "정형외과"},
        {"item_seq": "S000000011", "received_from": "정형외과"},
        {"item_seq": "S000000008", "received_from": "정형외과"},
        {"item_seq": "S000000101", "received_from": "약국에서 산 약"},
        {"display_name": "파스(이름 모름)"}
      ],
      "expect": {
        "rules": ["R2", "R3", "R4", "R5"],
        "counts": {"red": 1, "amber": 2, "grey": 1},
        "med_count": 9,
        "unchecked": ["파스(이름 모름)"],
        "findings": [
          {"severity": "red", "items": ["S000000010", "S000000101"],
           "body": "정형외과 진통제와 약국에서 산 종합감기약에 모두 아세트아미노펜이 들어 있어요. 함께 드셔도 되는지 약사님께 여쭤보세요."},
          {"group": "위산 억제제", "body_startswith": "OO내과 위장약과 정형외과 위장약은 같은 종류"},
          {"ingredients": ["클로르페니라민"]}
        ]
      }
    },
    {
      "name": "병용금기",
      "dataset": "sample",
      "age_band": "65+",
      "items": [
        {"item_seq": "S000000012", "received_from": "피부과"},
        {"item_seq": "S000000004", "received_from": "OO내과"}
      ],
      "expect": {"rules": ["R1"], "findings": [{"severity": "red", "ingredients": ["이트라코나졸", "심바스타틴"]}]}
    },
    {
      "name": "같은 곳에서 받은 효능군 중복은 회색",
      "dataset": "sample",
      "age_band": "under65",
      "items": [
        {"item_seq": "S000000005", "received_from": "OO내과"},
        {"item_seq": "S000000008", "received_from": "OO내과"}
      ],
      "expect": {"rules": ["R3_SAME"], "findings": [{"severity": "grey"}]}
    },
    {
      "name": "받은 곳을 모르는 효능군 중복은 주황",
      "dataset": "sample",
      "age_band": "under65",
      "items": [{"item_seq": "S000000011"}, {"item_seq": "S000000103"}],
      "expect": {"rules": ["R3"]}
    },
    {
      "name": "같은 성분은 효능군 중복으로 또 알리지 않음",
      "dataset": "sample",
      "age_band": "under65",
      "items": [
        {"item_seq": "S000000005", "received_from": "OO내과"},
        {"item_seq": "S000000007", "received_from": "정형외과"}
      ],
      "expect": {"rules": ["R2"]}
    },
    {
      "name": "노인주의는 65세 이상만",
      "dataset": "sample",
      "age_band": "65+",
      "items": [{"item_seq": "S000000014", "received_from": "정신건강의학과"}],
      "expect": {"rules": ["R4"]}
    },
    {
      "name": "노인주의는 65세 미만에는 없음",
      "dataset": "sample",
      "age_band": "under65",
      "items": [{"item_seq": "S000000014", "received_from": "정신건강의학과"}],
      "expect": {"rules": []}
    },
    {
      "name": "같은 약 두 번은 한 번으로",
      "dataset": "sample",
      "age_band": "under65",
      "items": [{"item_seq": "S000000001"}, {"item_seq": "S000000001"}],
      "expect": {"rules": [], "med_count": 1}
    },
    {
      "name": "약 4개는 다제약물 알림 없음",
      "dataset": "any",
      "age_band": "65+",
      "items": [{"display_name": "약0"}, {"display_name": "약1"}, {"display_name": "약2"}, {"display_name": "약3"}],
      "expect": {"rules": []}
    },
    {
      "name": "약 10개는 다제약물 관리 사업 안내",
      "dataset": "any",
      "age_band": "65+",
      "items": [
        {"display_name": "약0"}, {"display_name": "약1"}, {"display_name": "약2"}, {"display_name": "약3"},
        {"display_name": "약4"}, {"display_name": "약5"}, {"display_name": "약6"}, {"display_name": "약7"},
        {"display_name": "약8"}, {"display_name": "약9"}
      ],
      "expect": {"rules": ["R5_PROGRAM"], "findings": [{"title": "약을 10개 드시고 계세요"}]}
    }
  ]
}
